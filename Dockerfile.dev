# Production build for Kubernetes (standalone output serves /_next/static correctly)
FROM node:20-alpine AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package*.json ./
# Install devDependencies too (tailwind/postcss/typescript required for next build)
RUN npm ci --include=dev

COPY . .

ENV NODE_ENV=production
RUN npm run build
RUN test -d .next/static && test -f .next/standalone/server.js

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3005

# Standalone server + static assets (see Next.js Docker docs)
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3005

CMD ["node", "server.js"]
