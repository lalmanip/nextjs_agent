# Agent portal (login/signup) — REQUIRED; no hardcoded defaults in code
# AGENT_PORTAL_HOSTS=agent-dev.vivancetravels.com
# NEXT_PUBLIC_AGENT_PORTAL_URL=https://agent-dev.vivancetravels.com
# NEXT_PUBLIC_B2C_APP_URL=https://next.vivancetravels.com

# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://next.vivancetravels.com/vivapi-user
NEXT_PUBLIC_API_MT_BASE_URL=https://next.vivancetravels.com/vivapi-mt

# Holidays API (server-side proxy at /api/holidays/*)
HOLIDAY_API_BASE_URL=http://127.0.0.1:8095
NEXT_PUBLIC_API_KEY=viv-8806f318-1ecf-11ee-b64f-36e9be0141c6

# B2B agent portal coupons (vivance-ui uses B2C)
NEXT_PUBLIC_BOOKING_CHANNEL=B2B

# Domain Credentials (consider using secure environment variables)
NEXT_PUBLIC_DOMAIN_KEY=TMX5193291565602439
NEXT_PUBLIC_DOMAIN_USERNAME=test229267
NEXT_PUBLIC_DOMAIN_PASSWORD=test@229
NEXT_PUBLIC_DOMAIN_SYSTEM=test

# Dev/staging ribbon (omit or APP_ENVIRONMENT=production on prod)
# APP_ENVIRONMENT=dev

# Flight hold ticket on booking review (`on` | `off`). Default: on.
# FLIGHT_HOLD_ENABLED=off

# Default DOB for adult passengers on flight booking (not shown in UI). Format: YYYY-MM-DD
# DEFAULT_ADULT_DOB=2000-01-15

# LCC lead-passenger address (used automatically on commit; passengers do not enter it).
# Defaults are in src/config/lccLeadAddress.ts — override any field below:
# LCC_LEAD_ADDRESS_LINE1=Vivance Travels
# LCC_LEAD_ADDRESS_LINE2=Corporate office
# LCC_LEAD_CITY=Mumbai
# LCC_LEAD_STATE=Maharashtra
# LCC_LEAD_PIN_CODE=400001
# LCC_LEAD_COUNTRY_CODE=IN
# LCC_LEAD_COUNTRY_NAME=India

# Header nav: phased rollout — each is `on` | `hidden` | `maintenance`
# maintenance = show link (muted); click shows NEXT_PUBLIC_HEADER_NAV_MAINTENANCE_MESSAGE
# NEXT_PUBLIC_HEADER_NAV_FLIGHTS=on
# NEXT_PUBLIC_HEADER_NAV_HOTELS=maintenance
# NEXT_PUBLIC_HEADER_NAV_CRUISES=hidden
# NEXT_PUBLIC_HEADER_NAV_HOLIDAYS=on          # "Old Holidays" → /holidays
# NEXT_PUBLIC_HEADER_NAV_HOLIDAY_PARTNERS=on  # "Holidays" → /holiday-partners
# NEXT_PUBLIC_HEADER_NAV_MAINTENANCE_MESSAGE=We're updating this area. Please try again later.
