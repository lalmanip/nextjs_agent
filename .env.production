# API Mode: 'local' for localhost:8080 or 'remote' for vyseva.hawan.org
API_MODE=remote
NEXT_PUBLIC_API_MODE=remote

# Payment gateway: 'razorpay' | 'hdfc'  (switch to 'hdfc' to enable HDFC)
NEXT_PUBLIC_PAYMENT_GATEWAY=razorpay

# HDFC payment gateway backend base URL (trailing slash required)
HDFC_GATEWAY_URL=http://localhost:8083

# Header: Flights / Hotels / Cruises / Holidays — on | hidden | maintenance (default on if unset)
# NEXT_PUBLIC_HEADER_NAV_FLIGHTS=on
# NEXT_PUBLIC_HEADER_NAV_HOTELS=maintenance
# NEXT_PUBLIC_HEADER_NAV_CRUISES=hidden
# NEXT_PUBLIC_HEADER_NAV_HOLIDAYS=maintenance
